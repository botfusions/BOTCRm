# ===========================================
# BOTSCRM Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to git!
#
# ⚠️ VITE_ ile başlayan her değer tarayıcıya (JS paketine) gider; gizli değer koymayın.
#    Buraya yalnızca herkese açık olması sakıncasız değerler yazılır.

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
# anon (public) anahtar — service_role anahtarını ASLA buraya koymayın
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# GEMINI AI CONFIGURATION
# ===========================================
# Gemini anahtarı Supabase secret olarak ayarlanır (bkz. SECURITY.md)
#   supabase secrets set GEMINI_API_KEY=...

# ===========================================
# DİĞER SERVİSLER
# ===========================================
# OpenAI / Telegram / WhatsApp gibi gizli token'lar da tarayıcı ortam değişkeni
# olarak tanımlanmaz; sunucu tarafında (Supabase secret / n8n credential) tutulur.
